# Build dùng cho Docker/deploy: FE và BE cùng chạy sau một nginx, gọi API cùng-origin
# (nginx proxy /api và /uploads sang backend) nên để trống, không hardcode host:port.
VITE_API_BASE_URL=

# Keycloak không đi qua nginx proxy - trình duyệt gọi thẳng cổng expose ra host (xem
# sso/README.md về vì sao hostname nội bộ backend dùng khác với hostname này).
VITE_KEYCLOAK_URL=http://localhost:8180/realms/dxfarm
VITE_KEYCLOAK_CLIENT_ID=dxfarm-frontend
