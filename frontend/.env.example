# Biến VITE_* được nhúng vào bundle lúc build, chỉ chứa giá trị công khai.
# Sao chép thành frontend/.env khi chạy `npm run dev`; bản Docker Compose đặt các biến này ở deploy/docker-compose.yml.

# Địa chỉ API (gateway). Để trống thì dùng cùng origin với web.
VITE_API_BASE_URL=http://localhost:9080

# Realm Keycloak qua gateway. Để trống thì dùng <origin>/realms/dxos.
VITE_KEYCLOAK_URL=http://localhost:9080/realms/dxos

# Client OIDC của web (Authorization Code + PKCE).
VITE_KEYCLOAK_CLIENT_ID=dxos-web

# Liên kết tới BI trong trang thống kê của Lab. Để trống thì dùng <host>:9081/login/keycloak.
VITE_SUPERSET_URL=http://localhost:9081/login/keycloak
