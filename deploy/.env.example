# DX-OS: cấu hình Docker Compose.
#
# Sinh .env: ./make_env.sh (bản cài bằng install.sh làm sẵn).
# File .env nằm ngoài Git.
#
# TÊN=          : phải có giá trị.
# TÊN=giá trị   : dùng được ngay, đổi khi cần.
# # TÊN=giá trị : tùy chọn, bỏ dấu # để đặt.
#
# Hướng dẫn: docs/OPERATIONS.md, mục "Biến cấu hình .env".
#
# Mục lục:
#   1. Chạy và địa chỉ
#   2. Bí mật
#   3. Image và Compose
#   4. Cơ sở dữ liệu và kho tệp
#   5. Mô hình và sự kiện
#   6. Giám sát
#   7. Sao lưu
#   8. Tinh chỉnh và thành phần tùy chọn (bỏ qua được)


################################################################################
# 1. CHẠY VÀ ĐỊA CHỈ
################################################################################

# Chế độ chạy.
# full -> chạy cả Tầng 2: ứng dụng web, portal, giám sát và trợ lý.
# core -> chỉ chạy Tầng 1: API, Keycloak, dịch vụ lõi, PostgreSQL và kho tệp.
# Đổi bằng dxos start --full hoặc dxos start --core.
DXOS_MODE=full

# Nhóm dịch vụ Compose được bật, cách nhau bằng dấu phẩy.
# app: là các dịch vụ của chế độ full, dxos start --core bỏ nó.
# av: là ClamAV quét mã độc.
COMPOSE_PROFILES=app,av

# Địa chỉ máy chủ mà trình duyệt dùng để vào hệ thống.
# localhost: máy dev
# IP hoặc tên miền: máy chủ.
PUBLIC_HOST=localhost

# Cổng của gateway APISIX
APISIX_HOST_PORT=9080

# Địa chỉ công khai đầy đủ, tự ghép từ hai biến trên.
GATEWAY_PUBLIC_URL=http://${PUBLIC_HOST}:${APISIX_HOST_PORT}

# --- Máy chủ thật: xem trước lần khởi động đầu tiên ---
# Hướng dẫn: docs/OPERATIONS.md, mục "Máy chủ có tên miền và HTTPS".

# Đặt khi đứng sau proxy HTTPS.
# KEYCLOAK_HOSTNAME=${GATEWAY_PUBLIC_URL}

# Xác thực hai bước cho vai ADMIN (sso/README.md).
# CONDITIONAL: bật.
# DISABLED: tắt.
STAFF_OTP_FLOW=DISABLED

# Origin của giao diện ở tên miền khác được gọi API, cách nhau bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trang quản trị Keycloak tại /admin.
# true: mở.
# false: đóng.
KEYCLOAK_ADMIN_CONSOLE=false


################################################################################
# 2. BÍ MẬT
################################################################################

# make_env.sh điền sẵn.
# Không đổi sau khi đã có dữ liệu.

# --- Keycloak ---

# Tài khoản quản trị.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Client của dịch vụ lõi.
KEYCLOAK_ADMIN_CLIENT_ID=dxos-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Client của lệnh dxos.
DXOS_CLI_SECRET=

# --- PostgreSQL ---

# Superuser.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Role của Keycloak.
KEYCLOAK_DB_PASSWORD=

# Role chỉ đọc cho báo cáo (docs/REPORTING.md).
REPORT_DB_PASSWORD=

# --- Kho tệp (docs/STORAGE.md) ---

# Khóa S3.
S3_ACCESS_KEY=

# Secret S3, tối thiểu 16 ký tự.
S3_SECRET_KEY=

# --- Giám sát (docs/MONITORING.md) ---

# Role của dịch vụ giám sát.
MONITOR_DB_PASSWORD=

# Role chỉ đọc sự kiện đăng nhập.
KEYCLOAK_READONLY_DB_PASSWORD=

# Khóa gateway gửi sự kiện, chỉ dùng chữ và số.
MONITOR_INGEST_KEY=

# Đăng nhập màn hình giám sát.
MONITOR_OIDC_CLIENT_SECRET=

# Mật khẩu đọc số đo Prometheus, để trống thì đóng.
METRICS_PASSWORD=

# --- Sao lưu ---

# Mã hóa kho sao lưu.
# Cất một bản ngoài máy chủ: mất là mất mọi bản sao lưu.
BACKUP_PASSWORD=


################################################################################
# 3. IMAGE VÀ COMPOSE
################################################################################

# Để nguyên khi chạy từ mã nguồn.
# Bản cài bằng install.sh tự đặt.
# Hướng dẫn: docs/OPERATIONS.md, mục "Cài đặt và lệnh dxos".

# Nơi lấy image phát hành, không đặt thì build từ mã trên máy.
# DXOS_IMAGE_PREFIX=ghcr.io/haui-implsolution/dxos

# Phiên bản image.
# DXOS_IMAGE_TAG=latest

# Tên project Compose, mặc định là tên thư mục.
# COMPOSE_PROJECT_NAME=dxos

# Thêm tệp Compose của thành phần tùy chọn, cách nhau bằng dấu hai chấm.
# Prometheus: docker-compose.prometheus.yml
# MQTT: docker-compose.mqtt.yml
# COMPOSE_FILE=docker-compose.yml


################################################################################
# 4. CƠ SỞ DỮ LIỆU VÀ KHO TỆP
################################################################################

# Tên cơ sở dữ liệu.
POSTGRES_DB=dxos

# Thư mục dữ liệu PostgreSQL.
POSTGRES_DATA_DIR=./data/postgres

# Cổng PostgreSQL trên máy chủ.
POSTGRES_HOST_PORT=127.0.0.1:5432

# Địa chỉ nội bộ của kho tệp.
S3_ENDPOINT=http://seaweedfs:8333

# Bucket tệp đính kèm, đổi tên thì sửa cả apisix/common.yaml.
S3_BUCKET=dxos-uploads

# Quét mã độc (docs/OPERATIONS.md, mục "Quét mã độc tệp tải lên").
# Tắt: dxos av off.
STORAGE_SCAN_HOST=clamav


################################################################################
# 5. MÔ HÌNH VÀ SỰ KIỆN
################################################################################

# Tệp mô hình áp dụng khi khởi động, dxos start <tệp> tự đặt.
# Hướng dẫn: docs/OPERATIONS.md, mục "Tệp mô hình lúc khởi động".
# DXOS_MODEL_FILE=

# Webhook sự kiện của hồ sơ.
# Hướng dẫn: docs/INTEGRATIONS.md, mục "Webhook sự kiện".

# Đích mặc định.
# DXOS_WEBHOOK_URL=

# Khóa ký yêu cầu.
# DXOS_WEBHOOK_SECRET=

# json: nguyên thông điệp.
# chat: một câu cho Mattermost và Slack.
# DXOS_WEBHOOK_FORMAT=json


################################################################################
# 6. GIÁM SÁT
################################################################################

# Hướng dẫn: docs/MONITORING.md.

# Webhook nhận cảnh báo.
# ALERT_WEBHOOK_URL=

# Webhook kênh quản trị, được ưu tiên.
# ALERT_WEBHOOK_URL_ADMIN=


################################################################################
# 7. SAO LƯU
################################################################################

# Hướng dẫn: docs/OPERATIONS.md, mục "Sao lưu và khôi phục".

# Thư mục kho sao lưu.
# BACKUP_DIR=./backups

# Kho restic từ xa, thay cho thư mục trên.
# BACKUP_REPOSITORY=


################################################################################
# 8. TINH CHỈNH VÀ THÀNH PHẦN TÙY CHỌN (BỎ QUA ĐƯỢC)
################################################################################

# --- Kho tệp ---

# Thời hạn link tải tệp (docs/STORAGE.md).
# STORAGE_PRESIGN_TTL=15m

# Chờ trước khi xóa tệp đã gỡ (docs/OPERATIONS.md, mục "Tệp bị gỡ khỏi hồ sơ").
# DXOS_FILE_DELETE_DELAY=24h

# --- Sự kiện, quá hạn, giới hạn gọi (docs/OPERATIONS.md, mục "Biến tùy chọn") ---

# Số lần gửi thử một thông điệp.
# DXOS_OUTBOX_MAX_ATTEMPTS=20

# Nhịp xem hàng đợi sự kiện (mili giây).
# DXOS_OUTBOX_POLL_MS=2000

# Nhịp quét hồ sơ quá hạn (mili giây).
# DXOS_OVERDUE_SWEEP_MS=60000

# Báo sắp đến hạn trước bao lâu, 0 để tắt.
# DXOS_DUE_SOON_BEFORE=24h

# Giới hạn số lần gọi API, false khi thử tải.
# RATE_LIMIT_ENABLED=true

# --- Số đo và Prometheus (docs/MONITORING.md) ---

# Nhịp đếm lại số đo (mili giây).
# METRICS_REFRESH_MS=30000

# Địa chỉ mở Prometheus, không có đăng nhập.
# PROMETHEUS_BIND=127.0.0.1

# Cổng Prometheus.
# PROMETHEUS_HOST_PORT=9090

# Thời gian giữ số đo.
# PROMETHEUS_RETENTION=15d

# --- Lưu trữ hồ sơ đã đóng (docs/OPERATIONS.md, mục "Lưu trữ hồ sơ đã đóng") ---

# Bucket lưu trữ.
# S3_ARCHIVE_BUCKET=dxos-archive

# Lưu trữ hồ sơ đã đóng quá số ngày này.
# ARCHIVE_AFTER_DAYS=365

# Bộ nhớ tối đa khi truy vấn.
# ARCHIVE_QUERY_MEMORY_LIMIT=2GB

# Số thread khi truy vấn.
# ARCHIVE_QUERY_THREADS=2

# Dung lượng tệp tạm tối đa khi truy vấn.
# ARCHIVE_QUERY_TEMP_LIMIT=4GB

# --- GitOps (docs/OPERATIONS.md, mục "Kéo từ git") ---

# Kho tệp mô hình, để trống thì không kéo.
# GITOPS_REPO=

# Nhánh hoặc tag.
# GITOPS_REF=main

# Thư mục chứa tệp mô hình.
# GITOPS_PATH=models

# report, approve hoặc auto.
# GITOPS_MODE=report

# Kho hạ tầng, để trống thì không kéo.
# GITOPS_INFRA_REPO=

# Nhánh hoặc tag.
# GITOPS_INFRA_REF=main

# report, approve hoặc auto.
# GITOPS_INFRA_MODE=report

# Deploy key chỉ đọc.
# GITOPS_SSH_KEY=

# Tệp known_hosts.
# GITOPS_KNOWN_HOSTS=

# true: chỉ nhận commit có chữ ký.
# GITOPS_REQUIRE_SIGNED=false

# Danh sách khóa ký được tin.
# GITOPS_ALLOWED_SIGNERS=

# --- Cầu nối MQTT (docs/INTEGRATIONS.md) ---

# Địa chỉ mở broker, 0.0.0.0 cho thiết bị ngoài máy chủ.
# MQTT_BIND=127.0.0.1

# Cổng broker.
# MQTT_HOST_PORT=1883

# --- Trợ lý nghiệp vụ (assistant/README.md, mục "Cấu hình") ---

# Thư mục trọng số bộ phân loại trong container.
# ASSISTANT_CLASSIFIERS_DIR=/app/classifiers

# Địa chỉ thu hồi token của Keycloak.
# ASSISTANT_OIDC_REVOKE_URL=
