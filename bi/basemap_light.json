{
  "version": 8,
  "name": "DX-OS light basemap",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f1f3f2"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#e6ece6",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#dbe8dc",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#c9dbe8"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#b7cde0",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          0.5,
          12,
          2
        ]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "secondary",
          "tertiary",
          "minor",
          "service"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#dde1e4",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.3,
          16,
          2
        ]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#c3cad0",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.4,
          12,
          1.6,
          16,
          4
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#e3e6e8"
      }
    },
    {
      "id": "place-state",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 4,
      "filter": [
        "all",
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "state"
          ],
          true,
          false
        ],
        [
          "within",
          {
            "type": "Polygon",
            "coordinates": [
              [
                [
                  102,
                  8
                ],
                [
                  110,
                  8
                ],
                [
                  110,
                  23.5
                ],
                [
                  102,
                  23.5
                ],
                [
                  102,
                  8
                ]
              ]
            ]
          }
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:vi"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          10,
          8,
          13
        ],
        "text-max-width": 8,
        "symbol-sort-key": [
          "get",
          "rank"
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#37444c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "filter": [
        "all",
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "city"
          ],
          true,
          false
        ],
        [
          "within",
          {
            "type": "Polygon",
            "coordinates": [
              [
                [
                  102,
                  8
                ],
                [
                  110,
                  8
                ],
                [
                  110,
                  23.5
                ],
                [
                  102,
                  23.5
                ],
                [
                  102,
                  8
                ]
              ]
            ]
          }
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:vi"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          10,
          10,
          14
        ],
        "text-max-width": 8,
        "symbol-sort-key": [
          "get",
          "rank"
        ]
      },
      "paint": {
        "text-color": "#37444c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "filter": [
        "all",
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "town"
          ],
          true,
          false
        ],
        [
          "within",
          {
            "type": "Polygon",
            "coordinates": [
              [
                [
                  102,
                  8
                ],
                [
                  110,
                  8
                ],
                [
                  110,
                  23.5
                ],
                [
                  102,
                  23.5
                ],
                [
                  102,
                  8
                ]
              ]
            ]
          }
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:vi"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          11,
          14,
          14
        ],
        "text-max-width": 8,
        "symbol-sort-key": [
          "get",
          "rank"
        ]
      },
      "paint": {
        "text-color": "#37444c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ],
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf"
}
