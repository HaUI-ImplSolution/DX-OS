# DX-OS: cấu hình Docker Compose. Dùng:  ./make_env.sh  (sinh .env, điền sẵn mật khẩu ngẫu nhiên) rồi điền các biến còn trống.
#   TÊN=          phải điền, thiếu thì docker compose dừng và báo tên biến
#   TÊN=giá trị   dùng được ngay, đổi khi cần
#   # TÊN=giá trị tùy chọn, bỏ dấu # để đặt; không đặt thì dùng giá trị ghi kèm
# Giá trị ngẫu nhiên: openssl rand -base64 24. File .env nằm ngoài Git.


################################################################################
# 1. IMAGE
################################################################################

# Máy dev để trống hai biến này: Compose build image từ mã trên máy, đặt tên dxos-<tên>:local.
# Máy chủ bỏ dấu # để dùng image do workflow Release đẩy lên GHCR; cập nhật bằng ./update.sh.
# Bản cài bằng install.sh (lệnh dxos) đặt sẵn hai biến này và cập nhật bằng dxos update.
# DXOS_IMAGE_PREFIX=ghcr.io/haui-implsolution/dxos
# DXOS_IMAGE_TAG=latest

# Tên project Compose; bản cài bằng install.sh đặt dxos để không trùng stack dev (mặc định là tên thư mục).
# COMPOSE_PROJECT_NAME=dxos


################################################################################
# 2. ĐỊA CHỈ VÀ CỔNG
################################################################################

# Cổng trên máy chủ. Gateway: APISIX_HOST_PORT (web, API, Keycloak, Swagger, portal).
APISIX_HOST_PORT=9080
POSTGRES_HOST_PORT=127.0.0.1:5432

# Địa chỉ trình duyệt dùng để vào hệ thống: localhost trên máy dev, IP hoặc tên miền trên máy chủ.
# Đổi PUBLIC_HOST là đủ; địa chỉ dưới đây tự theo PUBLIC_HOST và cổng ở trên.
PUBLIC_HOST=localhost
GATEWAY_PUBLIC_URL=http://${PUBLIC_HOST}:${APISIX_HOST_PORT}

# Công khai qua Cloudflare Tunnel thay vì mở cổng: bỏ dấu # và điền token (xem docker-compose.cloudflared.yml).
# COMPOSE_FILE=docker-compose.yml:docker-compose.cloudflared.yml
# CLOUDFLARE_TUNNEL_TOKEN=


################################################################################
# 3. TÀI KHOẢN ĐĂNG NHẬP
################################################################################

# Keycloak Admin Console tại <GATEWAY_PUBLIC_URL>/admin.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Xác thực hai bước (TOTP) cho vai ADMIN: CONDITIONAL là bật, DISABLED là tắt.
# DISABLED (mặc định) để demo và CI đăng nhập bằng mật khẩu; máy chủ thật đặt CONDITIONAL trước lần
# khởi động đầu tiên (realm chỉ import một lần, xem sso/README.md để bật trên realm đã chạy).
STAFF_OTP_FLOW=DISABLED

# Lưu tệp (SeaweedFS): khóa S3 của dịch vụ lõi, cũng là khóa ký gRPC của filer (secret tối thiểu 16 ký tự).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# PostgreSQL superuser.
POSTGRES_USER=
POSTGRES_PASSWORD=


################################################################################
# 4. KHÓA VÀ SECRET NỘI BỘ
#    Giá trị ngẫu nhiên bất kỳ. Đổi sau khi đã có dữ liệu thì phải tạo lại dịch vụ tương ứng.
################################################################################

# Mật khẩu role Postgres của Keycloak; postgres/init tạo role lúc khởi tạo thư mục dữ liệu lần đầu.
KEYCLOAK_DB_PASSWORD=

# Role Postgres chỉ đọc cho báo cáo (report_ro), dịch vụ lõi tạo khi áp dụng mô hình.
REPORT_DB_PASSWORD=

# Màn hình giám sát: role Postgres của monitor (monitor-init tạo), role chỉ đọc sự kiện đăng nhập
# của Keycloak, khóa gateway dùng khi gửi sự kiện (chữ và số, không có | hoặc &) và secret đăng nhập.
MONITOR_DB_PASSWORD=
KEYCLOAK_READONLY_DB_PASSWORD=
MONITOR_INGEST_KEY=
MONITOR_OIDC_CLIENT_SECRET=

# Client OIDC trong Keycloak: dịch vụ lõi tạo client và vai của mô hình và quản lý người dùng.
KEYCLOAK_ADMIN_CLIENT_ID=dxos-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=


################################################################################
# 5. DÙNG CHUNG
################################################################################

POSTGRES_DB=dxos
POSTGRES_DATA_DIR=./data/postgres

# Sao lưu (deploy/backup.sh): mật khẩu mã hóa kho sao lưu. Mất mật khẩu là mất mọi bản sao lưu,
# nên cất ở nơi khác máy chủ. Kho nằm ở BACKUP_DIR (mặc định ./backups) hoặc BACKUP_REPOSITORY (restic từ xa).
BACKUP_PASSWORD=
# BACKUP_DIR=./backups
# BACKUP_REPOSITORY=

# Quét mã độc tệp tải lên bằng ClamAV (khoảng 1 GB RAM, tắt mặc định). Bỏ dấu # ở hai dòng cuối để bật.
# Bật rồi mà ClamAV không trả lời thì tệp không được lưu (HTTP 503).
# COMPOSE_PROFILES=av
# STORAGE_SCAN_HOST=clamav

# Lưu tệp: địa chỉ nội bộ và bucket riêng tư (đổi tên bucket thì sửa route /dxos-uploads/* ở apisix/common.yaml).
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=dxos-uploads

# Giới hạn số lần gọi mỗi người mỗi phút ở dịch vụ lõi; đặt false khi thử tải.
# RATE_LIMIT_ENABLED=true
# Thời hạn của link tệp có chữ ký.
# STORAGE_PRESIGN_TTL=15m

# Màn hình giám sát gửi cảnh báo tới kênh quản trị khi có webhook; để trống thì không gửi.
# MATTERMOST_WEBHOOK_URL=
# MATTERMOST_WEBHOOK_URL_ADMIN=
