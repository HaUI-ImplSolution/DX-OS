# Copy thành .env (cùng thư mục) rồi chỉnh lại trước khi chạy `docker compose up -d --build`
POSTGRES_DB=dxfarm
POSTGRES_USER=dxfarm
POSTGRES_PASSWORD=dxfarm

# Cổng expose ra host
POSTGRES_PORT=5432
BACKEND_PORT=8081
FRONTEND_PORT=8082
PORTAL_PORT=8090
SUPERSET_PORT=8088
MATTERMOST_PORT=8065

JWT_SECRET=
# Thời hạn token, tính bằng mili-giây (mặc định 86400000 = 24h nếu để trống)
JWT_EXPIRATION=

SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=

# Sinh SUPERSET_SECRET_KEY bằng: openssl rand -base64 42
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@dxfarm.local
# Mật khẩu role Postgres chỉ-đọc mà backend tự tạo cho Superset dùng (đổi nếu cần)
SUPERSET_RO_PASSWORD=superset_ro_demo_only

# Mật khẩu role Postgres riêng mà backend tự tạo cho Mattermost dùng (đổi nếu cần)
MATTERMOST_DB_PASSWORD=mattermost_demo_only
