# Điện thoại phải truy cập được gateway; dùng IP LAN của máy dev, không dùng localhost.
# Cổng khớp APISIX_HOST_PORT trong deploy/.env; API, Keycloak và ảnh đều đi qua gateway này.
# Máy chủ công khai dùng địa chỉ HTTPS không có số cổng, khớp GATEWAY_PUBLIC_URL (ví dụ https://khuongdev.io.vn).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:9080
EXPO_PUBLIC_KEYCLOAK_URL=http://192.168.1.10:9080/realms/dxos
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=farm-mobile
