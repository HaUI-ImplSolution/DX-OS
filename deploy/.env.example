################################################################################
# DX-OS: cấu hình Docker Compose
#
#   cp .env.example .env     rồi điền mọi biến đang để trống (xem mục 3 và 4)
#
# Cách đọc file:
# - `TÊN=` để trống: biến BẠN PHẢI ĐIỀN, thiếu thì `docker compose` dừng và báo tên biến đó.
# - `TÊN=giá trị`: mặc định dùng được ngay, đổi khi cần.
# - `# TÊN=giá trị`: biến tùy chọn, bỏ dấu `#` và điền khi muốn dùng.
# - Sinh nhanh một giá trị ngẫu nhiên:  openssl rand -base64 24
# - File .env nằm ngoài Git. Không đưa mật khẩu thật vào .env.example.
#
# Bố cục:  1. Ứng dụng
#          2. Địa chỉ và cổng
#          3. Tài khoản đăng nhập (người dùng thao tác)
#          4. Khóa và secret nội bộ (dịch vụ gọi nhau)
#          5. Cấu hình dùng chung cho mọi ứng dụng
#          6. Riêng Farm (DXOS_APP=farm)
#          7. Riêng Lab (DXOS_APP=lab)
#
# Tài khoản demo của từng ứng dụng do deploy/demo/seed_demo.py tạo
# và được ghi ở deploy/demo/README.md, không nằm trong file này.
################################################################################


################################################################################
# 1. ỨNG DỤNG
################################################################################

# Ứng dụng chạy cùng lõi dùng chung: farm hoặc lab; giá trị khác làm Backend dừng khi khởi động.
# Đổi bằng `./start.sh <app>` (hoặc `./switch-app.sh <app>`): script ghi biến này, dựng lại gateway,
# Backend, job nạp tri thức và Superset.
DXOS_APP=farm


################################################################################
# 2. ĐỊA CHỈ VÀ CỔNG
################################################################################

# --- Cổng mở ra máy chủ -------------------------------------------------------
# Gateway APISIX là cửa chung, mỗi cổng phục vụ một nhóm:
#   APISIX_HOST_PORT           web, API, Keycloak, ảnh, Swagger, portal (/portal/)
#   APISIX_SUPERSET_HOST_PORT  Superset (BI); bản 3.1 không chạy được dưới đường dẫn con
#   APISIX_MINIO_HOST_PORT     giao diện quản trị MinIO
APISIX_HOST_PORT=9080
APISIX_SUPERSET_HOST_PORT=9081
APISIX_MINIO_HOST_PORT=9082
# Hai dịch vụ còn lại không đi qua gateway.
MATTERMOST_HOST_PORT=8065
POSTGRES_HOST_PORT=5432

# --- Địa chỉ trình duyệt dùng để vào gateway -----------------------------------
# Cổng phải khớp các cổng ở trên. Đổi `localhost` thành IP LAN nếu mở từ máy khác.
GATEWAY_PUBLIC_URL=http://localhost:9080
SUPERSET_PUBLIC_URL=http://localhost:9081


################################################################################
# 3. TÀI KHOẢN ĐĂNG NHẬP (người dùng thao tác)
#    Mỗi khối là một dịch vụ; điền username và mật khẩu bạn muốn dùng.
################################################################################

# --- Keycloak: Admin Console (realm master) ------------------------------------
# Đăng nhập tại  <GATEWAY_PUBLIC_URL>/admin
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- Superset: tài khoản admin cục bộ ------------------------------------------
# Chỉ dùng cho script khởi tạo qua REST; giao diện Superset đăng nhập bằng Keycloak.
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@dxos.local
SUPERSET_ADMIN_PASSWORD=

# --- Mattermost: System Admin --------------------------------------------------
# Tự tạo lúc khởi động. Đăng nhập tại  http://localhost:<MATTERMOST_HOST_PORT>
MATTERMOST_ADMIN_USERNAME=admin
MATTERMOST_ADMIN_EMAIL=admin@dxos.local
MATTERMOST_ADMIN_PASSWORD=

# --- MinIO: tài khoản gốc (đồng thời là khóa S3 của Backend) --------------------
# Đăng nhập Console tại  http://localhost:<APISIX_MINIO_HOST_PORT>
# ACCESS_KEY đóng vai trò username, SECRET_KEY là mật khẩu (tối thiểu 8 ký tự).
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- PostgreSQL: tài khoản superuser -------------------------------------------
# Dùng với psql hoặc công cụ ngoài tại  localhost:<POSTGRES_HOST_PORT>
POSTGRES_USER=
POSTGRES_PASSWORD=


################################################################################
# 4. KHÓA VÀ SECRET NỘI BỘ (dịch vụ gọi nhau, không ai gõ tay)
#    Điền giá trị ngẫu nhiên bất kỳ, không cần nhớ. Đổi giá trị sau khi đã có dữ liệu
#    thì phải tạo lại dịch vụ tương ứng (mật khẩu role Postgres lưu trong DB).
################################################################################

# --- Mật khẩu role Postgres riêng của từng dịch vụ ------------------------------
# Backend tự tạo các role này lúc khởi động.
KEYCLOAK_DB_PASSWORD=
MATTERMOST_DB_PASSWORD=
SUPERSET_READONLY_DB_PASSWORD=
AI_VECTOR_DB_READONLY_PASSWORD=
AI_VECTOR_DB_INGEST_PASSWORD=

# --- API key giữa Backend và AI Service (mỗi chiều một khóa) ---------------------
BACKEND_TO_AI_API_KEY=
AI_TO_BACKEND_API_KEY=

# --- Client OIDC trong Keycloak (client id đi kèm secret) -----------------------
# Backend dùng để tạo tài khoản workspace và vai của ứng dụng (client dxos-backend-admin).
KEYCLOAK_ADMIN_CLIENT_ID=dxos-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Superset dùng để đăng nhập qua Keycloak (client dxos-superset).
SUPERSET_OIDC_CLIENT_ID=dxos-superset
SUPERSET_OIDC_CLIENT_SECRET=

# --- Khóa ký phiên của Superset -------------------------------------------------
# Sinh bằng:  openssl rand -base64 42
SUPERSET_SECRET_KEY=

# --- Mã SHA-256 của file trọng số mô hình AI ------------------------------------
# Được cấp cùng checkpoint; không lưu giá trị thật trong Git.
AI_CV_WEIGHTS_SHA256=


################################################################################
# 5. CẤU HÌNH DÙNG CHUNG CHO MỌI ỨNG DỤNG (không bí mật, có mặc định dùng được)
################################################################################

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=dxos
POSTGRES_DATA_DIR=./data/postgres

# --- Backend -------------------------------------------------------------------
# Địa chỉ nội bộ để AI Service gọi lại Backend.
BACKEND_BASE_URL=http://backend:8081

# --- Lưu ảnh (MinIO) -----------------------------------------------------------
# Địa chỉ nội bộ và tên bucket riêng tư. Route ảnh ở apisix/common.yaml trỏ
# /dxos-uploads/*, đổi tên bucket thì sửa route theo.
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=dxos-uploads

# --- AI Service ----------------------------------------------------------------
AI_BASE_URL=http://ai:8000
AI_CV_DEVICE=cpu
AI_LOG_LEVEL=INFO
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_DATA_DIR=../data
# Checkpoint chuẩn có sẵn trong ai/weights/ sau checkout.
AI_CV_WEIGHTS_PATH=../ai/weights/best.pt
# Classifier chuẩn có sẵn sau checkout, được mount read-only.
AI_CROP_CLASSIFIER_PATH=../ai/weights/crop_classifier.onnx
BACKEND_TO_AI_CONNECT_TIMEOUT_MS=3000
BACKEND_TO_AI_READ_TIMEOUT_MS=120000

# --- Ollama (chạy trong Compose; đổi URL nếu dùng Ollama ngoài) ------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# --- Giới hạn và ngưỡng (không đặt thì dùng giá trị ghi kèm) ---------------------
# Số yêu cầu một người được chờ duyệt cùng lúc.
# MAX_PENDING_REQUESTS=3
# Đoạn tri thức kém tương đồng với câu hỏi hơn ngưỡng này (0-1) thì không hiện.
# KNOWLEDGE_MIN_SCORE=0.40
# Thời hạn của link ảnh có chữ ký.
# STORAGE_PRESIGN_TTL=15m

# --- Thông báo sang Mattermost --------------------------------------------------
# Incoming Webhook để Backend đăng vào kênh chat. Không đặt thì tắt thông báo.
# Tạo trong Mattermost: Integrations -> Incoming Webhooks -> Add Incoming Webhook
# (xem chat/README.md). URL sao chép từ giao diện mang host localhost; đổi thành
# mattermost:8065, ví dụ http://mattermost:8065/hooks/<key>.
# MATTERMOST_WEBHOOK_URL=
# Kênh "Ban quản trị", dùng cho cả hai ứng dụng. Không đặt thì dùng MATTERMOST_WEBHOOK_URL.
# MATTERMOST_WEBHOOK_URL_ADMIN=
# Địa chỉ gateway mà người xem mở được, để thông báo kèm ảnh; để trống thì không kèm ảnh.
# Thường trùng GATEWAY_PUBLIC_URL.
MATTERMOST_IMAGE_BASE_URL=http://localhost:9080


################################################################################
# 6. RIÊNG FARM (chỉ dùng khi DXOS_APP=farm)
################################################################################

# Mở đầu mã thửa sinh tự động, ví dụ HTX01-H0042-T03.
HTX_CODE=HTX01

# Địa chỉ API thời tiết Open-Meteo (không cần key); trỏ tới địa chỉ không tồn tại để thử
# đường dự phòng (snapshot).
WEATHER_BASE_URL=https://api.open-meteo.com

# Sai số GPS (mét) lớn nhất mà thao tác của nông dân được chấp nhận; mobile lấy ngưỡng này từ Backend.
# GPS_MAX_ACCURACY_METERS=30

# Cron (Asia/Ho_Chi_Minh) nhắc thu hoạch hằng ngày.
# HARVEST_REMINDER_CRON=0 0 7 * * *

# Kênh "Kỹ sư nông nghiệp" (báo cáo và chẩn đoán chờ duyệt). Không đặt thì dùng MATTERMOST_WEBHOOK_URL.
# MATTERMOST_WEBHOOK_URL_ENGINEER=


################################################################################
# 7. RIÊNG LAB (chỉ dùng khi DXOS_APP=lab; không đặt thì dùng giá trị mặc định ghi kèm)
################################################################################

# Kênh "Kỹ thuật viên" (yêu cầu hỗ trợ mới, yêu cầu quá hạn).
# Không đặt thì dùng MATTERMOST_WEBHOOK_URL.
# MATTERMOST_WEBHOOK_URL_TECHNICIAN=

# Cron (Asia/Ho_Chi_Minh) kiểm tra hạn xử lý của yêu cầu hỗ trợ.
# LAB_SLA_CHECK_CRON=0 */5 * * * *
# Tỉ lệ thời hạn đã dùng hết thì cảnh báo.
# LAB_SLA_WARNING_RATIO=0.8
# Cron nhắc mượn trả hằng ngày.
# LAB_LOAN_REMINDER_CRON=0 0 7 * * *
# Số ngày trước hạn trả thì nhắc.
# LAB_LOAN_DUE_SOON_DAYS=1
