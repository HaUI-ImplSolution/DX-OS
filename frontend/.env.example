# Base URL của backend Spring Boot (không có dấu / ở cuối)
VITE_API_BASE_URL=http://localhost:8081

# Keycloak (SSO thật, xem sso/README.md) - realm URL trình duyệt gọi trực tiếp, khác hostname
# nội bộ backend dùng để xác thực token (xem application.yaml)
VITE_KEYCLOAK_URL=http://localhost:8180/realms/dxfarm
VITE_KEYCLOAK_CLIENT_ID=dxfarm-frontend
