# ------------------------------------------------------------------------------
# Cổng expose ra host
# ------------------------------------------------------------------------------
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8081
AI_HOST_PORT=8000
FRONTEND_HOST_PORT=8082
PORTAL_HOST_PORT=8090
KEYCLOAK_HOST_PORT=8180
SUPERSET_HOST_PORT=8088
MATTERMOST_HOST_PORT=8065

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=dxfarm
POSTGRES_USER=dxfarm
POSTGRES_PASSWORD=dxfarm
POSTGRES_DATA_DIR=./data/postgres

# ------------------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------------------
BACKEND_BASE_URL=http://backend:8081

# ------------------------------------------------------------------------------
# AI service
# ------------------------------------------------------------------------------
AI_BASE_URL=http://ai:8000
BACKEND_TO_AI_CONNECT_TIMEOUT_MS=3000
BACKEND_TO_AI_READ_TIMEOUT_MS=120000
AI_CV_DEVICE=cpu
AI_CV_CONFIDENCE_THRESHOLD=0.70
AI_CV_MIN_IMAGE_DIMENSION=160
AI_CV_MIN_SHARPNESS=10.0
AI_LOG_LEVEL=INFO
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_DATA_DIR=../data

# [BẮT BUỘC] Để trống thì chiều tương ứng bị từ chối (fail-closed).
BACKEND_TO_AI_API_KEY=backend_to_ai_demo_only
AI_TO_BACKEND_API_KEY=ai_to_backend_demo_only

# Role Postgres của AI Vector DB: chỉ-đọc cho runtime, đọc/ghi cho job ingest.
AI_VECTOR_DB_READONLY_PASSWORD=ai_vector_ro_demo_only
AI_VECTOR_DB_INGEST_PASSWORD=ai_vector_ingest_demo_only

# ------------------------------------------------------------------------------
# Ollama (chạy trong Compose; đổi URL nếu dùng Ollama ngoài)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ------------------------------------------------------------------------------
# Keycloak (SSO)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN_USERNAME=admin
# [BẮT BUỘC]
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=keycloak_demo_only
# URL Keycloak mà trình duyệt/điện thoại truy cập; để trống thì dùng http://localhost:${KEYCLOAK_HOST_PORT}.
# Dev mobile trên điện thoại thật: đặt thành http://<IP-LAN-máy-dev>:8180.
KEYCLOAK_PUBLIC_URL=

# ------------------------------------------------------------------------------
# Superset (BI)
# ------------------------------------------------------------------------------
# [BẮT BUỘC] Sinh bằng: openssl rand -base64 42
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@dxfarm.local
SUPERSET_READONLY_DB_PASSWORD=superset_ro_demo_only
# Client OAuth Superset dùng để đăng nhập qua Keycloak.
SUPERSET_OIDC_CLIENT_ID=dxfarm-superset
SUPERSET_OIDC_CLIENT_SECRET=dxfarm_superset_demo_secret

# ------------------------------------------------------------------------------
# Mattermost (chat)
# ------------------------------------------------------------------------------
MATTERMOST_DB_PASSWORD=mattermost_demo_only
