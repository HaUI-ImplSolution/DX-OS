# Copy thành deploy/.env (`cp .env.example .env`) rồi điền mọi biến đang để trống.
# Mọi biến đều bắt buộc; thiếu hoặc rỗng thì `docker compose` dừng và báo tên biến đó.

# ------------------------------------------------------------------------------
# Cổng expose ra host
# ------------------------------------------------------------------------------
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8081
AI_HOST_PORT=8000
FRONTEND_HOST_PORT=8082
PORTAL_HOST_PORT=8090
KEYCLOAK_HOST_PORT=8180
SUPERSET_HOST_PORT=8088
MATTERMOST_HOST_PORT=8065

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=dxfarm
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATA_DIR=./data/postgres

# ------------------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------------------
BACKEND_BASE_URL=http://backend:8081

# ------------------------------------------------------------------------------
# AI service
# ------------------------------------------------------------------------------
AI_BASE_URL=http://ai:8000
BACKEND_TO_AI_CONNECT_TIMEOUT_MS=3000
BACKEND_TO_AI_READ_TIMEOUT_MS=120000
AI_CV_DEVICE=cpu
AI_LOG_LEVEL=INFO
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_DATA_DIR=../data
# Checkpoint chuẩn đã có trong repo. Chỉ đổi khi cần dùng đường dẫn riêng trên máy;
# file thay thế vẫn phải có SHA-256 khớp model profile.
AI_CV_WEIGHTS_PATH=../ai/weights/best.pt
# [BẮT BUỘC] Key hai chiều Backend ↔ AI; điền giá trị bất kỳ khác rỗng.
BACKEND_TO_AI_API_KEY=
AI_TO_BACKEND_API_KEY=

# Role Postgres của AI Vector DB: chỉ-đọc cho runtime, đọc/ghi cho job ingest.
AI_VECTOR_DB_READONLY_PASSWORD=AiVectorRo123
AI_VECTOR_DB_INGEST_PASSWORD=AiVectorIngest123

# ------------------------------------------------------------------------------
# Ollama (chạy trong Compose; đổi URL nếu dùng Ollama ngoài)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ------------------------------------------------------------------------------
# Keycloak (SSO)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=Keycloak123
# URL Keycloak mà frontend và Superset (web) dùng, cổng khớp KEYCLOAK_HOST_PORT.
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# ------------------------------------------------------------------------------
# Superset (BI)
# ------------------------------------------------------------------------------
# [BẮT BUỘC] Sinh bằng: openssl rand -base64 42
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@dxfarm.local
SUPERSET_READONLY_DB_PASSWORD=Superset123
# Client OAuth Superset dùng để đăng nhập qua Keycloak.
SUPERSET_OIDC_CLIENT_ID=dxfarm-superset
SUPERSET_OIDC_CLIENT_SECRET=dxfarm_superset_demo_secret

# ------------------------------------------------------------------------------
# Mattermost (chat)
# ------------------------------------------------------------------------------
MATTERMOST_DB_PASSWORD=Mattermost123
# Tài khoản System Admin tự tạo lúc khởi động (đổi mật khẩu trước khi dùng ngoài local)
MATTERMOST_ADMIN_USERNAME=admin
MATTERMOST_ADMIN_EMAIL=admin@dxfarm.local
MATTERMOST_ADMIN_PASSWORD=
# URL Incoming Webhook để backend đăng thông báo vào channel "Kỹ sư nông nghiệp"; để trống thì tắt thông báo.
# Tạo trong Mattermost: Integrations -> Incoming Webhooks -> Add Incoming Webhook (xem chat/README.md).
# URL sao chép từ UI mang host localhost; đổi thành mattermost:8065, ví dụ http://mattermost:8065/hooks/<key>.
MATTERMOST_WEBHOOK_URL=
# Địa chỉ backend mà trình duyệt người xem truy cập được, để thông báo kèm ảnh báo cáo; để trống thì không kèm ảnh.
MATTERMOST_IMAGE_BASE_URL=http://localhost:8081
