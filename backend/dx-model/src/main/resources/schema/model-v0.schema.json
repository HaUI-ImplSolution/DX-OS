{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HaUI-ImplSolution/DX-OS/schemas/model-v0.schema.json",
  "title": "DX-OS model file, format 0",
  "type": "object",
  "required": ["format", "name", "roles", "entities"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": 0 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
    "webhook": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,39}$" },
          "description": { "type": "string" },
          "staff": { "type": "boolean" }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,39}$" },
          "label": { "type": "string" }
        }
      }
    },
    "entities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,39}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["fields", "access"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "owner_via": { "type": "string" },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,39}$" },
            "additionalProperties": {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": ["text", "number", "datetime", "choice", "reference", "user", "unit", "file"]
                },
                "label": { "type": "string" },
                "required": { "type": "boolean" },
                "unique": { "type": "boolean" },
                "options": { "type": "array", "minItems": 1, "items": {"type": "string"} },
                "to": { "type": "string" },
                "renamed_from": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                "default": { "type": ["string", "number"] }
              }
            }
          },
          "access": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "enum": ["all", "own", "read", "unit", "assigned"] }
          },
          "process": {
            "type": "object",
            "required": ["handler"],
            "additionalProperties": false,
            "properties": {
              "family": { "enum": ["approval", "work_item", "reservation"] },
              "handler": {
                "anyOf": [{"type": "string"}, {"type": "array", "minItems": 1, "items": {"type": "string"}}]
              },
              "initial": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
              "states": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                "additionalProperties": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "properties": { "label": {"type": "string"}, "terminal": {"type": "boolean"} }
                }
              },
              "actions": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                "additionalProperties": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "properties": {
                    "label": { "type": "string" },
                    "from": {
                      "anyOf": [
                        { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                        {
                          "type": "array",
                          "minItems": 1,
                          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" }
                        }
                      ]
                    },
                    "to": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                    "by": { "enum": ["handler", "owner"] },
                    "role": {
                      "anyOf": [
                        { "type": "string" },
                        { "type": "array", "minItems": 1, "items": {"type": "string"} }
                      ]
                    },
                    "needs_note": { "type": "boolean" },
                    "require": {
                      "anyOf": [
                        { "type": "string" },
                        { "type": "array", "minItems": 1, "items": {"type": "string"} }
                      ]
                    },
                    "when": {
                      "type": ["string", "null"],
                      "pattern": "^\\s*[a-z][a-z0-9_]*\\s*(==|!=|<=|>=|<|>)\\s*\\S.*$"
                    }
                  }
                }
              },
              "allow_self_decision": { "type": "boolean" },
              "deadline": { "type": "string", "pattern": "^[0-9]{1,6}[mhd]$" },
              "auto_close": {
                "anyOf": [
                  { "type": "string", "pattern": "^[0-9]{1,6}[mhd]$" },
                  {
                    "type": "object",
                    "required": ["after", "action"],
                    "additionalProperties": false,
                    "properties": {
                      "after": { "type": "string", "pattern": "^[0-9]{1,6}[mhd]$" },
                      "action": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" }
                    }
                  }
                ]
              },
              "booking": {
                "type": "object",
                "required": ["resource", "starts", "ends"],
                "additionalProperties": false,
                "properties": {
                  "resource": { "type": "string" },
                  "starts": { "type": "string" },
                  "ends": { "type": "string" },
                  "capacity": { "type": "integer", "minimum": 1 }
                }
              },
              "after": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["do", "user"],
                    "additionalProperties": false,
                    "properties": {
                      "do": { "enum": ["add_to_group", "remove_from_group"] },
                      "user": { "type": "string" },
                      "group": { "type": "string" },
                      "group_from": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
