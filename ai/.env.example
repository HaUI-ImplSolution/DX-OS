# Role chỉ-đọc (ai_vector_ro) trên DB pgvector riêng dx_farm_ai_vector_db - do Backend tự tạo
# lúc khởi động (AiVectorDatabaseSeeder). Không còn trỏ vào DB nghiệp vụ dùng chung với Backend.
DATABASE_URL=postgresql+psycopg://ai_vector_ro:ai_vector_ro_demo_only@localhost:5432/dx_farm_ai_vector_db
# Role đọc/ghi (ai_vector_ingest) dùng riêng cho job ingest RAG (scripts/ingest_diseases.py).
RAG_INGEST_DATABASE_URL=postgresql+psycopg://ai_vector_ingest:ai_vector_ingest_demo_only@localhost:5432/dx_farm_ai_vector_db

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

CV_WEIGHTS_PATH=./weights/best.pt
CV_WEIGHTS_SHA256=573DB0871F39396F2BBEC5E6AA5988D36B79B13E01CB00F03EEE29B32A12C60B
CV_CLASS_CONTRACT_PATH=../data/structured/class_contract.json
CV_NUM_CLASSES=5
CV_IMAGE_SIZE=640
CV_MODEL_NAME=YOLOv8n-RiceLeafBD
CV_MODEL_VERSION=3.0.0
CV_DEVICE=auto
CV_DETECTION_CONFIDENCE_THRESHOLD=0.25
CV_IOU_THRESHOLD=0.45
# Ngưỡng nghiệp vụ đánh dấu low-confidence sau inference, không phải ngưỡng lọc box YOLO.
CV_CONFIDENCE_THRESHOLD=0.70
LLM_TIMEOUT_SECONDS=5

BACKEND_BASE_URL=http://localhost:8081
# Phải trùng AI_SERVICE_INBOUND_API_KEY ở Backend.
BACKEND_SERVICE_API_KEY=
BACKEND_TIMEOUT_SECONDS=3
BACKEND_MAX_ATTEMPTS=2
BACKEND_RETRY_BACKOFF_SECONDS=0.2
# Phải trùng AI_SERVICE_API_KEY mà Backend gửi sang AI.
AI_SERVICE_API_KEY=

LOG_LEVEL=INFO
