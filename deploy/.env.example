# DX-OS: cấu hình Docker Compose. Dùng:  cp .env.example .env  rồi điền các biến để trống.
#   TÊN=          phải điền, thiếu thì docker compose dừng và báo tên biến
#   TÊN=giá trị   dùng được ngay, đổi khi cần
#   # TÊN=giá trị tùy chọn, bỏ dấu # để đặt; không đặt thì dùng giá trị ghi kèm
# Giá trị ngẫu nhiên: openssl rand -base64 24. File .env nằm ngoài Git.
# Tài khoản demo do deploy/demo/seed_demo.py tạo, xem deploy/demo/README.md.


################################################################################
# 1. ỨNG DỤNG
################################################################################

# Ứng dụng chạy: farm hoặc lab. Đổi bằng ./start.sh <app> hoặc ./switch-app.sh <app>.
DXOS_APP=farm

# Máy dev để trống hai biến này: Compose build image từ mã trên máy, đặt tên dxos-<tên>:local.
# Máy chủ bỏ dấu # để dùng image do workflow Release đẩy lên GHCR; cập nhật bằng ./update.sh.
# DXOS_IMAGE_PREFIX=ghcr.io/haui-implsolution/dxos
# DXOS_IMAGE_TAG=latest


################################################################################
# 2. ĐỊA CHỈ VÀ CỔNG
################################################################################

# Cổng trên máy chủ. Gateway: APISIX_HOST_PORT (web, API, Keycloak, Swagger, portal),
APISIX_HOST_PORT=9080
APISIX_SUPERSET_HOST_PORT=9081
# Console MinIO chỉ dành cho quản trị: mặc định chỉ mở trên chính máy chủ (qua tunnel/Cloudflare Access vẫn vào được).
APISIX_MINIO_HOST_PORT=127.0.0.1:9082
MATTERMOST_HOST_PORT=8065
POSTGRES_HOST_PORT=127.0.0.1:5432

# Địa chỉ trình duyệt dùng để vào hệ thống: localhost trên máy dev, IP hoặc tên miền trên máy chủ.
# Đổi PUBLIC_HOST là đủ; các địa chỉ dưới đây tự theo PUBLIC_HOST và các cổng ở trên.
PUBLIC_HOST=localhost
GATEWAY_PUBLIC_URL=http://${PUBLIC_HOST}:${APISIX_HOST_PORT}
SUPERSET_PUBLIC_URL=http://${PUBLIC_HOST}:${APISIX_SUPERSET_HOST_PORT}

# Link BI, MinIO Console và chat trên portal khi chúng có địa chỉ riêng, ví dụ https://bi.example.com.
# Để trống thì portal dùng tên máy của trang đang mở với các cổng ở trên.
PORTAL_BI_URL=
PORTAL_MINIO_URL=
PORTAL_CHAT_URL=

# Công khai qua Cloudflare Tunnel thay vì mở cổng: bỏ dấu # và điền token (xem docker-compose.cloudflared.yml).
# COMPOSE_FILE=docker-compose.yml:docker-compose.cloudflared.yml
# CLOUDFLARE_TUNNEL_TOKEN=


################################################################################
# 3. TÀI KHOẢN ĐĂNG NHẬP
################################################################################

# Keycloak Admin Console tại <GATEWAY_PUBLIC_URL>/admin.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Xác thực hai bước (TOTP) cho vai ADMIN, ENGINEER, TECHNICIAN: CONDITIONAL là bật, DISABLED là tắt.
# DISABLED (mặc định) để demo và CI đăng nhập bằng mật khẩu; máy chủ thật đặt CONDITIONAL trước lần
# khởi động đầu tiên (realm chỉ import một lần, xem sso/README.md để bật trên realm đã chạy).
STAFF_OTP_FLOW=DISABLED

# Superset: chỉ script khởi tạo dùng; giao diện đăng nhập bằng Keycloak.
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@dxos.local
SUPERSET_ADMIN_PASSWORD=

# Mattermost System Admin, tự tạo lúc khởi động.
MATTERMOST_ADMIN_USERNAME=admin
MATTERMOST_ADMIN_EMAIL=admin@dxos.local
MATTERMOST_ADMIN_PASSWORD=

# MinIO: khóa gốc, cũng là khóa S3 của Backend (secret tối thiểu 8 ký tự).
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# PostgreSQL superuser.
POSTGRES_USER=
POSTGRES_PASSWORD=


################################################################################
# 4. KHÓA VÀ SECRET NỘI BỘ
#    Giá trị ngẫu nhiên bất kỳ. Đổi sau khi đã có dữ liệu thì phải tạo lại dịch vụ tương ứng.
################################################################################

# Mật khẩu role Postgres của từng dịch vụ, Backend tạo lúc khởi động.
KEYCLOAK_DB_PASSWORD=
MATTERMOST_DB_PASSWORD=
SUPERSET_READONLY_DB_PASSWORD=
AI_VECTOR_DB_READONLY_PASSWORD=
AI_VECTOR_DB_INGEST_PASSWORD=

# Màn hình giám sát: role Postgres của monitor (monitor-init tạo), role chỉ đọc sự kiện đăng nhập
# của Keycloak, khóa gateway dùng khi gửi sự kiện (chữ và số, không có | hoặc &) và secret đăng nhập.
MONITOR_DB_PASSWORD=
KEYCLOAK_READONLY_DB_PASSWORD=
MONITOR_INGEST_KEY=
MONITOR_OIDC_CLIENT_SECRET=

# API key giữa Backend và AI Service, mỗi chiều một khóa.
BACKEND_TO_AI_API_KEY=
AI_TO_BACKEND_API_KEY=

# Client OIDC trong Keycloak: Backend tạo tài khoản và vai, Superset đăng nhập.
KEYCLOAK_ADMIN_CLIENT_ID=dxos-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
SUPERSET_OIDC_CLIENT_ID=dxos-superset
SUPERSET_OIDC_CLIENT_SECRET=

# Khóa ký phiên Superset: openssl rand -base64 42.
SUPERSET_SECRET_KEY=

# SHA-256 của checkpoint đã ghép; cách tính tại ai/README.md, không dùng giá trị ngẫu nhiên.
AI_CV_WEIGHTS_SHA256=


################################################################################
# 5. DÙNG CHUNG CHO MỌI ỨNG DỤNG
################################################################################

POSTGRES_DB=dxos
POSTGRES_DATA_DIR=./data/postgres

# Sao lưu (deploy/backup.sh): mật khẩu mã hóa kho sao lưu. Mất mật khẩu là mất mọi bản sao lưu,
# nên cất ở nơi khác máy chủ. Kho nằm ở BACKUP_DIR (mặc định ./backups) hoặc BACKUP_REPOSITORY (restic từ xa).
BACKUP_PASSWORD=
# BACKUP_DIR=./backups
# BACKUP_REPOSITORY=

# Quét mã độc tệp tải lên bằng ClamAV (khoảng 1 GB RAM, tắt mặc định). Bỏ dấu # ở hai dòng cuối để bật.
# Bật rồi mà ClamAV không trả lời thì tệp không được lưu (HTTP 503).
# COMPOSE_PROFILES=av
# STORAGE_SCAN_HOST=clamav

# Địa chỉ nội bộ để AI Service gọi lại Backend.
BACKEND_BASE_URL=http://backend:8081

# Lưu ảnh: địa chỉ nội bộ và bucket riêng tư (đổi tên bucket thì sửa route /dxos-uploads/* ở apisix/common.yaml).
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=dxos-uploads

# AI Service: trọng số có sẵn trong ai/weights/ sau checkout; timeout là của Backend khi gọi AI.
AI_BASE_URL=http://ai:8000
AI_CV_DEVICE=cpu
AI_LOG_LEVEL=INFO
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_DATA_DIR=../data
# Đường dẫn trong image AI; checkpoint được ghép từ các phần trong Git khi build.
AI_CV_WEIGHTS_PATH=/opt/dxos/models/efficientnetv2m_rice_disease.pth
AI_CROP_CLASSIFIER_PATH=../ai/weights/crop_classifier.onnx
# SHA-256 của tệp ở AI_CROP_CLASSIFIER_PATH; cách tính tại ai/README.md, không dùng giá trị ngẫu nhiên.
AI_CROP_CLASSIFIER_SHA256=
BACKEND_TO_AI_CONNECT_TIMEOUT_MS=3000
BACKEND_TO_AI_READ_TIMEOUT_MS=120000

# Ollama chạy trong Compose; đổi URL nếu dùng Ollama ngoài.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Máy không có AVX chạy Qwen quá chậm: đặt false để hỏi đáp chỉ trả tài liệu nguyên văn.
# AI_ANSWER_GENERATION=true
# Số đoạn đưa vào rerank của chatbot (4-40); CPU chậm thì giảm để rerank xong trong 6 giây.
# AI_CHAT_CANDIDATE_COUNT=20

# Số yêu cầu một người được chờ duyệt cùng lúc.
# MAX_PENDING_REQUESTS=3
# Đoạn tri thức có độ tương đồng thấp hơn ngưỡng này (0-1) thì không hiện.
# KNOWLEDGE_MIN_SCORE=0.40
# Thời hạn của link ảnh có chữ ký.
# STORAGE_PRESIGN_TTL=15m

# Mattermost: webhook từng kênh do mattermost-bootstrap tự tạo; chỉ đặt MATTERMOST_WEBHOOK_URL*
# để ghi đè.
# Webhook cho kênh không có webhook riêng.
# MATTERMOST_WEBHOOK_URL=
# Kênh "Ban quản trị" (cả hai ứng dụng).
# MATTERMOST_WEBHOOK_URL_ADMIN=
# Địa chỉ gateway người xem mở được, để thông báo kèm ảnh. Không đặt: không kèm ảnh.
MATTERMOST_IMAGE_BASE_URL=${GATEWAY_PUBLIC_URL}
# Địa chỉ web người xem mở được, để tiêu đề thông báo là liên kết mở báo cáo. Không đặt: không có liên kết.
MATTERMOST_APP_BASE_URL=${GATEWAY_PUBLIC_URL}


################################################################################
# 6. RIÊNG FARM (DXOS_APP=farm)
################################################################################

# Mở đầu mã thửa sinh tự động, ví dụ HTX01-H0042-T03.
HTX_CODE=HTX01

# API thời tiết Open-Meteo (không cần key). Trỏ tới địa chỉ không tồn tại để thử snapshot dự phòng.
WEATHER_BASE_URL=https://api.open-meteo.com

# Sai số GPS (mét) lớn nhất được chấp nhận; mobile lấy ngưỡng này từ Backend.
# GPS_MAX_ACCURACY_METERS=30
# Cron (Asia/Ho_Chi_Minh) nhắc thu hoạch hằng ngày.
# HARVEST_REMINDER_CRON=0 0 7 * * *
# Số ngày nhắc thu hoạch, tính từ ngày thu hoạch dự kiến.
# HARVEST_REMINDER_MAX_DAYS=14
# Cron (Asia/Ho_Chi_Minh) nhắc kênh kỹ sư về bản khai phun chờ xác nhận.
# TREATMENT_CONFIRMATION_REMINDER_CRON=0 0 8 * * *
# Số giờ chờ xác nhận thì bắt đầu nhắc.
# TREATMENT_CONFIRMATION_WAIT_HOURS=24
# Kênh "Kỹ sư nông nghiệp".
# MATTERMOST_WEBHOOK_URL_ENGINEER=


################################################################################
# 7. RIÊNG LAB (DXOS_APP=lab)
################################################################################

# Kênh "Kỹ thuật viên".
# MATTERMOST_WEBHOOK_URL_TECHNICIAN=
# Cron (Asia/Ho_Chi_Minh) kiểm tra hạn xử lý yêu cầu hỗ trợ.
# LAB_SLA_CHECK_CRON=0 */5 * * * *
# Tỉ lệ thời hạn đã dùng hết thì cảnh báo.
# LAB_SLA_WARNING_RATIO=0.8
# Số yêu cầu cùng một thiết bị trong khoảng ngày thì báo kênh kỹ thuật viên.
# LAB_DEVICE_ALERT_THRESHOLD=3
# LAB_DEVICE_ALERT_WINDOW_DAYS=30
# Cron nhắc mượn trả hằng ngày.
# LAB_LOAN_REMINDER_CRON=0 0 7 * * *
# Số ngày trước hạn trả thì nhắc.
# LAB_LOAN_DUE_SOON_DAYS=1
