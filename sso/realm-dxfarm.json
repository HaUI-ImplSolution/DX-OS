{
  "realm": "dxfarm",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "FARMER", "description": "Nông hộ - gửi báo cáo bệnh, xem thửa ruộng của mình" },
      { "name": "ENGINEER", "description": "Kỹ sư nông nghiệp - duyệt/từ chối chẩn đoán, xác nhận đã phun" },
      { "name": "ADMIN", "description": "Quản trị viên" }
    ]
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false, \"required\": {\"roles\": [\"user\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false, \"required\": {\"roles\": [\"user\"]}}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "dxfarm-frontend",
      "name": "DX-Farm frontend",
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "redirectUris": [
        "http://localhost:9080/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:9080",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:9080/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "dxfarm-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "dxfarm-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ]
    },
    {
      "clientId": "dxfarm-mobile",
      "name": "DX-Farm mobile",
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "redirectUris": [
        "dxfarm://*",
        "exp://*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "dxfarm://*##exp://*"
      },
      "protocolMappers": [
        {
          "name": "dxfarm-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "dxfarm-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ]
    },
    {
      "clientId": "dxfarm-superset",
      "name": "DX-Farm Superset",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${SUPERSET_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "redirectUris": [
        "http://localhost:9081/oauth-authorized/keycloak"
      ],
      "webOrigins": [
        "http://localhost:9081"
      ],
      "frontchannelLogout": true,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:9081/*",
        "frontchannel.logout.url": "http://localhost:9081/logout/"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ]
    },
    {
      "clientId": "dxfarm-backend-admin",
      "name": "DX-Farm backend (account management)",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false
    }
  ],
  "users": [
    {
      "username": "service-account-dxfarm-backend-admin",
      "enabled": true,
      "serviceAccountClientId": "dxfarm-backend-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "view-realm"]
      }
    },
    {
      "username": "farmer1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Nguyễn Văn",
      "lastName": "Nông",
      "email": "farmer1@dxfarm.local",
      "credentials": [
        { "type": "password", "value": "farmer123", "temporary": false }
      ],
      "realmRoles": ["FARMER"]
    },
    {
      "username": "engineer1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Trần",
      "lastName": "Kỹ Sư",
      "email": "engineer1@dxfarm.local",
      "credentials": [
        { "type": "password", "value": "engineer123", "temporary": false }
      ],
      "realmRoles": ["ENGINEER"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Quản Trị",
      "lastName": "Viên",
      "email": "admin1@dxfarm.local",
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["ADMIN"]
    }
  ]
}
