# DX-OS: cấu hình Docker Compose. Dùng:  ./make_env.sh  (sinh .env, điền sẵn mật khẩu ngẫu nhiên) rồi điền các biến còn trống.
#   TÊN=          phải điền, thiếu thì docker compose dừng và báo tên biến
#   TÊN=giá trị   dùng được ngay, đổi khi cần
#   # TÊN=giá trị tùy chọn, bỏ dấu # để đặt; không đặt thì dùng giá trị ghi kèm
# Mật khẩu, secret và khóa là giá trị ngẫu nhiên bất kỳ (openssl rand -base64 24); đổi sau khi đã có dữ liệu thì phải tạo lại dịch vụ tương ứng.
# File .env nằm ngoài Git.
#
# Mục lục: 1 Image · 2 Địa chỉ và cổng · 3 Keycloak · 4 Cơ sở dữ liệu · 5 Lưu tệp · 6 Mô hình và sự kiện · 7 Giám sát · 8 Sao lưu


################################################################################
# 1. IMAGE
################################################################################

# Máy dev để trống hai biến này: Compose build image từ mã trên máy, đặt tên dxos-<tên>:local.
# Máy chủ bỏ dấu # để dùng image do workflow Release đẩy lên GHCR; cập nhật bằng ./update.sh.
# Bản cài bằng install.sh (lệnh dxos) đặt sẵn hai biến này và cập nhật bằng dxos update.
# DXOS_IMAGE_PREFIX=ghcr.io/haui-implsolution/dxos
# DXOS_IMAGE_TAG=latest

# Tên project Compose; bản cài bằng install.sh đặt dxos để không trùng stack dev (mặc định là tên thư mục).
# COMPOSE_PROJECT_NAME=dxos


################################################################################
# 2. ĐỊA CHỈ VÀ CỔNG
################################################################################

# Cổng trên máy chủ. Gateway: APISIX_HOST_PORT (web, API, Keycloak, Swagger, portal).
APISIX_HOST_PORT=9080
POSTGRES_HOST_PORT=127.0.0.1:5432

# Địa chỉ trình duyệt dùng để vào hệ thống: localhost trên máy dev, IP hoặc tên miền trên máy chủ.
# Đổi PUBLIC_HOST là đủ; địa chỉ dưới đây tự theo PUBLIC_HOST và cổng ở trên.
PUBLIC_HOST=localhost
GATEWAY_PUBLIC_URL=http://${PUBLIC_HOST}:${APISIX_HOST_PORT}

# Optional personal assistants; no provider key or Telegram token belongs in this file.
# ASSISTANT_IMAGE=dxos-assistant:local
# ASSISTANT_RUNTIME_COUNT=2
# ASSISTANT_CONTROL_MEMORY=512m
# ASSISTANT_CONTROL_CPUS=0.5
# ASSISTANT_RUNTIME_MEMORY=2048m
# ASSISTANT_RUNTIME_CPUS=1


################################################################################
# 3. KEYCLOAK VÀ ĐĂNG NHẬP
################################################################################

# Tài khoản quản trị Keycloak (Admin Console tại <GATEWAY_PUBLIC_URL>/admin).
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Địa chỉ công khai của Keycloak khi hệ thống đứng sau proxy HTTPS (máy chủ thật): đặt bằng GATEWAY_PUBLIC_URL.
# Không đặt thì Keycloak lấy địa chỉ từ request, nên sau proxy HTTPS nó sinh địa chỉ http:// và đăng nhập lỗi.
# Đặt rồi thì trình duyệt luôn nhận địa chỉ này, còn gateway và backend vẫn gọi Keycloak qua mạng nội bộ.
# KEYCLOAK_HOSTNAME=${GATEWAY_PUBLIC_URL}

# Xác thực hai bước (TOTP) cho vai ADMIN: CONDITIONAL là bật, DISABLED là tắt.
# DISABLED (mặc định) để demo và CI đăng nhập bằng mật khẩu; máy chủ thật đặt CONDITIONAL trước lần
# khởi động đầu tiên (realm chỉ import một lần, xem sso/README.md để bật trên realm đã chạy).
STAFF_OTP_FLOW=DISABLED

# Client OIDC trong Keycloak: dịch vụ lõi tạo client và vai của mô hình và quản lý người dùng.
KEYCLOAK_ADMIN_CLIENT_ID=dxos-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Client OIDC `dxos-cli`: lệnh `dxos plan` và `dxos apply` lấy token ADMIN bằng secret này.
DXOS_CLI_SECRET=

# Mật khẩu role Postgres của Keycloak; postgres/init tạo role lúc khởi tạo thư mục dữ liệu lần đầu.
KEYCLOAK_DB_PASSWORD=


################################################################################
# 4. CƠ SỞ DỮ LIỆU (PostgreSQL)
################################################################################

# Superuser và cơ sở dữ liệu của hệ thống.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=dxos
POSTGRES_DATA_DIR=./data/postgres

# Role Postgres chỉ đọc cho báo cáo (report_ro), dịch vụ lõi tạo khi áp dụng mô hình.
REPORT_DB_PASSWORD=


################################################################################
# 5. LƯU TỆP (SeaweedFS, quét mã độc)
################################################################################

# Khóa S3 của dịch vụ lõi, cũng là khóa ký gRPC của filer (secret tối thiểu 16 ký tự).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Địa chỉ nội bộ và bucket riêng tư (đổi tên bucket thì sửa route /dxos-uploads/* ở apisix/common.yaml).
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=dxos-uploads

# Thời hạn của link tệp có chữ ký.
# STORAGE_PRESIGN_TTL=15m

# Thời gian chờ trước khi xóa tệp đã gỡ khỏi kho. Một lượt sao lưu ngắn hơn khoảng này luôn có đủ tệp của các dòng trong bản dump.
# DXOS_FILE_DELETE_DELAY=24h

# Quét mã độc tệp tải lên bằng ClamAV (khoảng 1 GB RAM, tắt mặc định). Bỏ dấu # ở hai dòng cuối để bật.
# Bật rồi mà ClamAV không trả lời thì tệp không được lưu (HTTP 503).
# COMPOSE_PROFILES=av
# STORAGE_SCAN_HOST=clamav


################################################################################
# 6. MÔ HÌNH VÀ SỰ KIỆN
################################################################################

# Tên các tệp mô hình trong deploy/model/, cách nhau bằng dấu phẩy, mà backend áp dụng lần lượt khi khởi động nếu tệp mới.
# Để trống thì không áp dụng gì; dxos start <tệp>... tự sao chép các tệp vào đó và đặt biến này.
# DXOS_MODEL_FILE=

# Webhook nhận mọi dòng lịch sử của hồ sơ (tạo, sửa, xóa, hành động, giao việc, tệp, quá hạn) dạng JSON.
# Đây là đích mặc định của mô hình không ghi khóa webhook; mô hình ghi tên đích thì địa chỉ của đích đó nằm trong webhooks/targets.yml (mẫu: webhooks/targets.example.yml).
# Để trống thì mô hình không ghi khóa webhook không gửi gì. Có DXOS_WEBHOOK_SECRET thì mỗi yêu cầu kèm chữ ký HMAC-SHA256 ở header X-Dxos-Signature.
# DXOS_WEBHOOK_URL=
# DXOS_WEBHOOK_SECRET=
# Dạng thông điệp của đích mặc định: json (nguyên thông điệp) hoặc chat (một câu dạng {"text": ...} cho Mattermost và Slack). Đích trong webhooks/targets.yml có khóa format riêng.
# DXOS_WEBHOOK_FORMAT=json

# Số lần gửi thử một thông điệp outbox (webhook, hành động hoàn tất) trước khi dừng và chờ bấm Thử lại ở tab Hàng đợi sự kiện.
# DXOS_OUTBOX_MAX_ATTEMPTS=20

# Mili giây giữa hai lần xem hàng đợi sự kiện, và giữa hai lần quét hồ sơ quá hạn.
# DXOS_OUTBOX_POLL_MS=2000
# DXOS_OVERDUE_SWEEP_MS=60000

# Một hồ sơ có hạn xử lý dài hơn khoảng này nhận dòng due_soon khi còn chừng đó thời gian trước hạn; 0 để tắt.
# DXOS_DUE_SOON_BEFORE=24h

# Giới hạn số lần gọi mỗi người mỗi phút ở dịch vụ lõi; đặt false khi thử tải.
# RATE_LIMIT_ENABLED=true


################################################################################
# 7. GIÁM SÁT
################################################################################

# Role Postgres của monitor (monitor-init tạo) và role chỉ đọc sự kiện đăng nhập của Keycloak.
MONITOR_DB_PASSWORD=
KEYCLOAK_READONLY_DB_PASSWORD=

# Khóa gateway dùng khi gửi sự kiện (chữ và số, không có | hoặc &) và secret đăng nhập OIDC của màn hình giám sát.
MONITOR_INGEST_KEY=
MONITOR_OIDC_CLIENT_SECRET=

# Màn hình giám sát gửi cảnh báo tới kênh quản trị khi có webhook; để trống thì không gửi.
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_URL_ADMIN=


################################################################################
# 8. SAO LƯU
################################################################################

# Sao lưu (deploy/backup.sh): mật khẩu mã hóa kho sao lưu. Mất mật khẩu là mất mọi bản sao lưu,
# nên cất ở nơi khác máy chủ. Kho nằm ở BACKUP_DIR (mặc định ./backups) hoặc BACKUP_REPOSITORY (restic từ xa).
BACKUP_PASSWORD=
# BACKUP_DIR=./backups
# BACKUP_REPOSITORY=
