# Role chỉ-đọc (ai_vector_ro) trên DB pgvector riêng dx_farm_ai_vector_db - do Backend tự tạo
# lúc khởi động (AiVectorDatabaseSeeder). Không còn trỏ vào DB nghiệp vụ dùng chung với Backend.
DATABASE_URL=postgresql+psycopg://ai_vector_ro:ai_vector_ro_demo_only@localhost:5432/dx_farm_ai_vector_db
# Role đọc/ghi (ai_vector_ingest) dùng riêng cho job ingest RAG (scripts/ingest_diseases.py).
INGEST_DATABASE_URL=postgresql+psycopg://ai_vector_ingest:ai_vector_ingest_demo_only@localhost:5432/dx_farm_ai_vector_db

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

HF_REPO_ID=Khawajaa/plant-disease-detector
WEIGHTS_FILENAME=best_model.pth
CV_NUM_CLASSES=38
CV_IMAGE_SIZE=224
CV_MODEL_NAME=EfficientNet-B4
CV_MODEL_VERSION=v1.0
CV_CONFIDENCE_THRESHOLD=0.70
LLM_TIMEOUT_SECONDS=5

LOG_LEVEL=INFO
