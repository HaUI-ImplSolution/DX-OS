# Điện thoại phải truy cập được hai địa chỉ này; dùng IP LAN của máy dev, không dùng localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8081
# Realm URL của Keycloak; phải trùng KEYCLOAK_PUBLIC_URL trong deploy/.env.
EXPO_PUBLIC_KEYCLOAK_URL=http://192.168.1.10:8180/realms/dxfarm
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=dxfarm-mobile
