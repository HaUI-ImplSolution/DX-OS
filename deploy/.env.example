# Copy thành .env (cùng thư mục) rồi chỉnh lại trước khi chạy `docker compose up -d --build`
POSTGRES_DB=dxfarm
POSTGRES_USER=dxfarm
POSTGRES_PASSWORD=dxfarm

# Cổng expose ra host
POSTGRES_PORT=5432
BACKEND_PORT=8081
FRONTEND_PORT=8082
PORTAL_PORT=8090
SUPERSET_PORT=8088
MATTERMOST_PORT=8065
KEYCLOAK_PORT=8180
AI_SERVICE_PORT=8000

# Identity Provider (SSO thật)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
# Mật khẩu role Postgres riêng mà backend tự tạo cho Keycloak dùng (đổi nếu cần)
KEYCLOAK_DB_PASSWORD=keycloak_demo_only

# Sinh SUPERSET_SECRET_KEY bằng: openssl rand -base64 42
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@dxfarm.local
# Mật khẩu role Postgres chỉ-đọc mà backend tự tạo cho Superset dùng (đổi nếu cần)
SUPERSET_RO_PASSWORD=superset_ro_demo_only

# Client OAuth Superset dùng để đăng nhập qua Keycloak (SSO thật) - đổi secret nếu cần
KEYCLOAK_SUPERSET_CLIENT_ID=dxfarm-superset
KEYCLOAK_SUPERSET_CLIENT_SECRET=dxfarm_superset_demo_secret

# Mật khẩu role Postgres riêng mà backend tự tạo cho Mattermost dùng (đổi nếu cần)
MATTERMOST_DB_PASSWORD=mattermost_demo_only

# AI Service (Python FastAPI & LangGraph)
DATABASE_URL=postgresql+psycopg://dxfarm:dxfarm@localhost:5432/dxfarm
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

HF_REPO_ID=Khawajaa/plant-disease-detector
WEIGHTS_FILENAME=best_model.pth
CV_NUM_CLASSES=38
CV_IMAGE_SIZE=224
CV_MODEL_NAME=EfficientNet-B4
CV_MODEL_VERSION=v1.0
CV_CONFIDENCE_THRESHOLD=0.70
LLM_TIMEOUT_SECONDS=5

LOG_LEVEL=INFO

