# Cấu hình của cầu nối MQTT tùy chọn. Chép thành deploy/mqtt.env (ngoài Git) rồi điền các giá trị bên dưới.
# Chỉ có tác dụng khi deploy/.env đặt COMPOSE_FILE=docker-compose.yml:docker-compose.mqtt.yml; xem docs/INTEGRATIONS.md.

# Tài khoản của broker, cho thiết bị và cho cầu nối. Mật khẩu sinh bằng: openssl rand -hex 24
MQTT_USER=dxos-mqtt
MQTT_PASSWORD=

# Client của cầu nối, đăng ký bằng: dxos client add itot-mqtt --model plant --role SENSOR --env MQTT_BRIDGE
# rồi dán hai dòng MQTT_BRIDGE_CLIENT_ID và MQTT_BRIDGE_CLIENT_SECRET mà lệnh in ra.
MQTT_BRIDGE_CLIENT_ID=
MQTT_BRIDGE_CLIENT_SECRET=

# Tuyến của cầu nối: chủ đề nào thành hồ sơ của mô hình nào. Không đặt thì dùng mqtt/bridge.json (sự cố của mẫu plant).
# Đặt thành một dòng JSON, cú pháp ở docs/INTEGRATIONS.md; giá trị này nằm trong deploy/mqtt.env nên bản cập nhật không ghi đè.
# MQTT_BRIDGE_ROUTES='{"routes":[{"topic":"plant/+/reading","model":"plant","entity":"incident","record":{"device":"{topic.1}","metric":"{payload.metric}","reading":"{payload.reading}","threshold":80,"observation":"{payload.observation}"}}]}'
