# Evaluation only. Copying this file is unnecessary; evaluate.sh creates private state.
EVAL_PROJECT=dx-rag-evaluation-runner
EVAL_VIEW_TIMEOUT_SECONDS=600
EVAL_START_TIMEOUT_SECONDS=600
EVAL_MIN_AVAILABLE_MIB=2500
EVAL_MIN_DISK_MIB=6144
EVAL_MIN_COLD_DISK_MIB=16384
EVAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EVAL_AI_PORT=18088
EVAL_LANGFUSE_PORT=13000
EVAL_REPORT_PORT=18765
EVAL_AI_CPUS=2
EVAL_AI_MEMORY=1536m
EVAL_VECTOR_CPUS=1
EVAL_VECTOR_MEMORY=256m
EVAL_UI_CPUS=1
EVAL_WEB_MEMORY=1g
EVAL_WORKER_MEMORY=768m
EVAL_CLICKHOUSE_MEMORY=768m
EVAL_LF_POSTGRES_MEMORY=256m
EVAL_REDIS_MEMORY=128m
EVAL_MINIO_MEMORY=192m
EVAL_POSTGRES_DB=dxos_ai_vector_db
EVAL_POSTGRES_USER=eval_admin
EVAL_READONLY_USER=eval_ro
EVAL_LOGIN_EMAIL=rag-evaluator@example.invalid
EVAL_MINIO_USER=evalstorage
EVAL_TOOL_IMAGE=dxos-rag-evaluation-tool:2
EVAL_MINIO_IMAGE=dxos-rag-evaluation-minio:2025-10-15
EVAL_POSTGRES_IMAGE=pgvector/pgvector:pg16
EVAL_LANGFUSE_IMAGE=docker.langfuse.com/langfuse/langfuse:4.70.1
EVAL_WORKER_IMAGE=docker.langfuse.com/langfuse/langfuse-worker:4.70.1
EVAL_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.12
EVAL_REDIS_IMAGE=redis:7
K6_VERSION=2.3.0
# Generated outside Git: database/API/storage passwords, Langfuse keys and login password.
# EVAL_STATE_DIR can override the state location derived from XDG_DATA_HOME/HOME.
